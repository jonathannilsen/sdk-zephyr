config SYSBUILD_HAL_NORDIC_MODULE
	bool

menu "nrf-regtool options"
	depends on SOC_SERIES_NRF54HX || SOC_SERIES_NRF92X

config NRF_REGTOOL_VALIDATE_UICR
	bool "Validate UICRs"
	help
	  Check that the UICR hex files generated by nrf-regtool constitute
	  a valid system configuration.

